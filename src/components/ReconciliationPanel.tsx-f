import { prisma } from "@/lib/prisma";
import { formatNaira } from "@/lib/utils";
import { CashTxnDirection } from "@prisma/client";
import { Scale } from "lucide-react";

export async function ReconciliationPanel({ projectId }: { projectId: string }) {
  const [accounts, txns, project] = await Promise.all([
    prisma.bankAccount.findMany({ where: { projectId } }),
    prisma.cashTransaction.findMany({ where: { projectId } }),
    prisma.project.findUnique({
      where: { id: projectId },
      include: { conditionPrecedent: true },
    }),
  ]);

  const rows = accounts.map((acct) => {
    const acctTxns = txns.filter((t) => t.bankAccountId === acct.id);
    const inSum = acctTxns
      .filter((t) => t.direction === CashTxnDirection.IN)
      .reduce((s, t) => s + t.amount, 0);
    const outSum = acctTxns
      .filter((t) => t.direction === CashTxnDirection.OUT)
      .reduce((s, t) => s + t.amount, 0);
    const ledgerNet = inSum - outSum;
    const discrepancy = acct.balance - ledgerNet;
    return {
      id: acct.id,
      type: acct.type,
      bankBalance: acct.balance,
      ledgerNet,
      discrepancy,
      reconciled: Math.abs(discrepancy) < 0.01,
    };
  });

  const bankTotal = accounts.reduce((s, a) => s + a.balance, 0);
  const ledgerTotal = rows.reduce((s, r) => s + r.ledgerNet, 0);
  const allReconciled = rows.every((r) => r.reconciled);

  return (
    <div className="space-y-4">
      <div className="flex items-center justify-between">
        <h2 className="text-md font-bold text-white flex items-center">
          <Scale className="w-5 h-5 text-sky-400 mr-2" />
          Trustee ↔ Bank Reconciliation
        </h2>
        <span
          className={`text-xs font-semibold px-2.5 py-1 rounded-md ${
            allReconciled
              ? "bg-emerald-500/10 text-emerald-400 border border-emerald-500/20"
              : "bg-rose-500/10 text-rose-400 border border-rose-500/20"
          }`}
        >
          {allReconciled ? "Reconciled" : "Reconciliation Required"}
        </span>
      </div>

      <div className="overflow-x-auto">
        <table className="w-full text-left text-sm">
          <thead className="text-xs uppercase text-slate-400 border-b border-slate-800">
            <tr>
              <th className="px-3 py-2">Trust Account</th>
              <th className="px-3 py-2">Bank Balance</th>
              <th className="px-3 py-2">Ledger Net</th>
              <th className="px-3 py-2">Discrepancy</th>
            </tr>
          </thead>
          <tbody className="divide-y divide-slate-800">
            {rows.map((r) => (
              <tr key={r.id}>
                <td className="px-3 py-2 text-slate-300">{r.type}</td>
                <td className="px-3 py-2 font-mono text-white">{formatNaira(r.bankBalance)}</td>
                <td className="px-3 py-2 font-mono text-white">{formatNaira(r.ledgerNet)}</td>
                <td
                  className={`px-3 py-2 font-mono ${
                    r.reconciled ? "text-emerald-400" : "text-rose-400"
                  }`}
                >
                  {r.reconciled ? "✓ 0.00" : formatNaira(r.discrepancy)}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div className="flex justify-between text-xs text-slate-400 border-t border-slate-800 pt-2">
        <span>Total bank position</span>
        <span className="font-mono text-white">{formatNaira(bankTotal)}</span>
        <span>Total ledger position</span>
        <span className="font-mono text-white">{formatNaira(ledgerTotal)}</span>
      </div>

      {project?.conditionPrecedent?.lienVacated && (
        <p className="text-xs text-emerald-400">
          ✓ Registered land-registry lien vacated — investor exit processed.
        </p>
      )}
    </div>
  );
}
